{
  "name": "e2e",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "stack:up": "docker compose -p energywatch-e2e -f ../docker-compose.yml -f ../docker-compose.e2e.yml up -d --build",
    "stack:down": "docker compose -p energywatch-e2e -f ../docker-compose.yml -f ../docker-compose.e2e.yml down -v",
    "test:fresh": "npm run stack:up && (E2E_BASE_URL=http://localhost:3100 playwright test; status=$?; npm run stack:down; exit $status)"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
